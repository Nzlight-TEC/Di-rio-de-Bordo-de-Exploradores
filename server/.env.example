# Copie para server/.env e preencha

# Porta do servidor
PORT=3001

# String de conexão Postgres/Supabase
# Pode ser DATABASE_URL ou SUPABASE_URL (o código aceita ambos)
DATABASE_URL=
# SUPABASE_URL=

# Autenticação do sync (Bearer)
SYNC_AUTH_TOKEN=
# Alternativa compatível com código atual:
# SUPABASE_KEY=

# Chave de criptografia (precisa ter pelo menos 32 caracteres)
SYNC_ENCRYPTION_KEY=
# Alternativa compatível com código atual:
# SUPABASE_ENCRYPTION_KEY=

